{%- comment -%}
  vf-atelier-page — Atelier landing surface (Obsidian editorial).

  Bound to templates/page.atelier.json. Four fixed-order content
  regions, all section settings (no blocks) to lock order:

    A · Opening   eyebrow + headline (with italic span) + body
    B · Process   four step settings groups, hairline between
    C · Scope     eyebrow + heading + body + optional vf-pull
    D · Intake    {%- form 'contact' -%} with contact[Form source]
                  = "Atelier brief" hidden input. Mirrors §22 status
                  + error treatment, inverted to Obsidian editorial.

  Focus ring: 2px Teal Bright per AGENTS.md §3 editorial spec —
  global ring from vf-tokens.css §4 already resolves via
  --vf-color-eyebrow (teal-bright on Obsidian). §23 only thickens
  the input border on focus to prevent double-line with the ring.

  All §23 styling lives in assets/vf-tokens.css.

  Distinct from sections/vf-atelier.liquid — that file is the
  homepage Ember CTA strip and is unchanged.
{%- endcomment -%}

<section class="vf-atelier-page">
  <div class="vf-atelier-page__inner page-width page-width--narrow">

    {%- comment -%} ── A · Opening ── {%- endcomment -%}
    <header class="vf-atelier-page__opening">
      {%- if section.settings.eyebrow != blank -%}
        {%- render 'vf-eyebrow', text: section.settings.eyebrow -%}
      {%- endif -%}
      <h1 class="vf-atelier-page__headline">
        {{- section.settings.headline_part_1 | escape -}}
        {%- if section.settings.headline_italic != blank -%}
          <em>{{- section.settings.headline_italic | escape -}}</em>
        {%- endif -%}
      </h1>
      {%- if section.settings.opening_body != blank -%}
        <div class="vf-atelier-page__opening-body">
          {{- section.settings.opening_body -}}
        </div>
      {%- endif -%}
    </header>

    <hr class="vf-atelier-page__rule" aria-hidden="true">

    {%- comment -%} ── B · Process ── {%- endcomment -%}
    <section class="vf-atelier-page__process" aria-labelledby="VfAtelierPageProcessHeading">
      <h2 id="VfAtelierPageProcessHeading" class="visually-hidden">Process</h2>

      <ol class="vf-atelier-page__steps" role="list">
        {%- for i in (1..4) -%}
          {%- assign number_key = 'step_' | append: i | append: '_number' -%}
          {%- assign title_key  = 'step_' | append: i | append: '_title' -%}
          {%- assign body_key   = 'step_' | append: i | append: '_body' -%}
          {%- assign step_number = section.settings[number_key] -%}
          {%- assign step_title  = section.settings[title_key] -%}
          {%- assign step_body   = section.settings[body_key] -%}

          {%- if step_title != blank or step_body != blank -%}
            <li class="vf-atelier-page__step">
              {%- if step_number != blank -%}
                <div class="vf-atelier-page__step-number">
                  {%- render 'vf-mono', text: step_number, size: 'display', color: 'teal' -%}
                </div>
              {%- endif -%}
              <div class="vf-atelier-page__step-content">
                {%- if step_title != blank -%}
                  <h3 class="vf-atelier-page__step-title">{{ step_title | escape }}</h3>
                {%- endif -%}
                {%- if step_body != blank -%}
                  <div class="vf-atelier-page__step-body">{{ step_body }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </section>

    <hr class="vf-atelier-page__rule" aria-hidden="true">

    {%- comment -%} ── C · Scope ── {%- endcomment -%}
    <section class="vf-atelier-page__scope" aria-labelledby="VfAtelierPageScopeHeading">
      {%- if section.settings.scope_eyebrow != blank -%}
        {%- render 'vf-eyebrow', text: section.settings.scope_eyebrow -%}
      {%- endif -%}
      <h2 id="VfAtelierPageScopeHeading" class="vf-atelier-page__scope-heading">
        {{- section.settings.scope_heading | escape -}}
      </h2>
      {%- if section.settings.scope_body != blank -%}
        <div class="vf-atelier-page__scope-body">
          {{- section.settings.scope_body -}}
        </div>
      {%- endif -%}
      {%- if section.settings.pull_text != blank -%}
        <div class="vf-atelier-page__pull">
          {%- render 'vf-pull',
              text: section.settings.pull_text,
              attribution: section.settings.pull_attribution -%}
        </div>
      {%- endif -%}
    </section>

    <hr class="vf-atelier-page__rule" aria-hidden="true">

    {%- comment -%} ── D · Intake form ── {%- endcomment -%}
    <section class="vf-atelier-page__intake" aria-labelledby="VfAtelierPageIntakeHeading">
      <h2 id="VfAtelierPageIntakeHeading" class="vf-atelier-page__intake-heading">Brief intake.</h2>

      {%- form 'contact', id: 'VfAtelierPageForm', class: 'vf-atelier-page__form' -%}

        <input type="hidden" name="contact[Form source]" value="Atelier brief">

        {%- if form.posted_successfully? -%}
          <div class="vf-atelier-page__status vf-atelier-page__status--success" role="status" tabindex="-1" autofocus>
            <p class="vf-atelier-page__status-text">
              {%- if section.settings.success_message != blank -%}
                {{ section.settings.success_message | escape }}
              {%- else -%}
                {{ 'templates.contact.form.post_success' | t }}
              {%- endif -%}
            </p>
          </div>
        {%- elsif form.errors -%}
          <div class="vf-atelier-page__status vf-atelier-page__status--error" role="alert" tabindex="-1" autofocus>
            <p class="vf-atelier-page__status-text">
              {{ 'templates.contact.form.error_heading' | t }}
            </p>
            <ul class="vf-atelier-page__status-list" role="list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="vf-atelier-page__fields">

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-name">
              Name
            </label>
            <input
              class="vf-atelier-page__input"
              type="text"
              id="VfAtelierPageForm-name"
              name="contact[Name]"
              autocomplete="name"
              aria-required="true"
              aria-label="Name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="vf-atelier-page__field{% if form.errors contains 'email' %} vf-atelier-page__field--error{% endif %}">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-email">
              Email
            </label>
            <input
              class="vf-atelier-page__input"
              type="email"
              id="VfAtelierPageForm-email"
              name="contact[Email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              aria-required="true"
              aria-label="Email"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="VfAtelierPageForm-email-error"
              {% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <small class="vf-atelier-page__field-error" id="VfAtelierPageForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-context">
              Project context
            </label>
            <input
              class="vf-atelier-page__input"
              type="text"
              id="VfAtelierPageForm-context"
              name="contact[Project context]"
              aria-required="true"
              aria-label="Project context"
              required
              placeholder="Architect, interior lead, private commission"
            >
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-use">
              Intended use
            </label>
            <textarea
              class="vf-atelier-page__textarea"
              id="VfAtelierPageForm-use"
              name="contact[Intended use]"
              aria-required="true"
              aria-label="Intended use"
              aria-describedby="VfAtelierPageForm-use-help"
              required
              rows="4"
            ></textarea>
            <small class="vf-atelier-page__field-help" id="VfAtelierPageForm-use-help">
              Two to four sentences. The space, the object's intended position, and any dimensional or material constraints.
            </small>
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-scale">
              Scale
            </label>
            <input
              class="vf-atelier-page__input"
              type="text"
              id="VfAtelierPageForm-scale"
              name="contact[Scale]"
              aria-required="true"
              aria-label="Scale"
              required
              placeholder="Object size or room scale"
            >
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-timeline">
              Timeline
            </label>
            <input
              class="vf-atelier-page__input"
              type="text"
              id="VfAtelierPageForm-timeline"
              name="contact[Timeline]"
              aria-required="true"
              aria-label="Timeline"
              required
              placeholder="Target month or season"
            >
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-budget">
              Budget band
              <span class="vf-atelier-page__optional">(optional)</span>
            </label>
            <input
              class="vf-atelier-page__input"
              type="text"
              id="VfAtelierPageForm-budget"
              name="contact[Budget band]"
              aria-label="Budget band, optional"
            >
          </div>

          <div class="vf-atelier-page__field">
            <label class="vf-atelier-page__label" for="VfAtelierPageForm-references">
              References
              <span class="vf-atelier-page__optional">(optional)</span>
            </label>
            <textarea
              class="vf-atelier-page__textarea"
              id="VfAtelierPageForm-references"
              name="contact[References]"
              aria-label="References, optional"
              rows="3"
            ></textarea>
          </div>

        </div>

        <div class="vf-atelier-page__submit-row">
          <button type="submit" class="vf-atelier-page__submit">
            {{ section.settings.submit_label | escape }}
          </button>
        </div>

      {%- endform -%}
    </section>

  </div>
</section>

{% schema %}
{
  "name": "Voxel Forge · Atelier (page)",
  "tag": "section",
  "class": "shopify-section--vf-atelier-page",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "header", "content": "A · Opening" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Atelier · Commission"
    },
    {
      "type": "text",
      "id": "headline_part_1",
      "label": "Headline",
      "default": "One object."
    },
    {
      "type": "text",
      "id": "headline_italic",
      "label": "Headline (italic span)",
      "default": "Made for one room."
    },
    {
      "type": "richtext",
      "id": "opening_body",
      "label": "Opening body",
      "default": "<p>Placeholder. Studio copy pending.</p>"
    },

    { "type": "header", "content": "B · Process · Step 1" },
    { "type": "text",     "id": "step_1_number", "label": "Number", "default": "01" },
    { "type": "text",     "id": "step_1_title",  "label": "Title",  "default": "Brief" },
    { "type": "richtext", "id": "step_1_body",   "label": "Body",   "default": "<p>Placeholder.</p>" },

    { "type": "header", "content": "B · Process · Step 2" },
    { "type": "text",     "id": "step_2_number", "label": "Number", "default": "02" },
    { "type": "text",     "id": "step_2_title",  "label": "Title",  "default": "Studio response" },
    { "type": "richtext", "id": "step_2_body",   "label": "Body",   "default": "<p>Placeholder.</p>" },

    { "type": "header", "content": "B · Process · Step 3" },
    { "type": "text",     "id": "step_3_number", "label": "Number", "default": "03" },
    { "type": "text",     "id": "step_3_title",  "label": "Title",  "default": "Production" },
    { "type": "richtext", "id": "step_3_body",   "label": "Body",   "default": "<p>Placeholder.</p>" },

    { "type": "header", "content": "B · Process · Step 4" },
    { "type": "text",     "id": "step_4_number", "label": "Number", "default": "04" },
    { "type": "text",     "id": "step_4_title",  "label": "Title",  "default": "Delivery" },
    { "type": "richtext", "id": "step_4_body",   "label": "Body",   "default": "<p>Placeholder.</p>" },

    { "type": "header", "content": "C · Scope" },
    { "type": "text",     "id": "scope_eyebrow", "label": "Eyebrow", "default": "Scope" },
    { "type": "text",     "id": "scope_heading", "label": "Heading", "default": "Capability" },
    { "type": "richtext", "id": "scope_body",    "label": "Body",    "default": "<p>Placeholder.</p>" },
    { "type": "text",     "id": "pull_text",        "label": "Pull-quote (optional)" },
    { "type": "text",     "id": "pull_attribution", "label": "Pull-quote attribution (optional)" },

    { "type": "header", "content": "D · Intake form" },
    { "type": "text", "id": "submit_label",    "label": "Submit button label", "default": "Submit brief" },
    { "type": "text", "id": "success_message", "label": "Success message",
      "default": "Your brief is with the studio. We respond within five working days." }
  ]
}
{% endschema %}
