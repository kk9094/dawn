{%- comment -%}
  vf-contact — Bone-register contact surface.

  Owns: section header (eyebrow + heading + intro richtext), the contact
  form via {%- form 'contact' -%} with .vf-contact* classes (Dawn .field/
  .contact primitives are NOT reused — full surface re-skin), and a
  business-identity + grievance display block.

  Form fields:
    contact[name]                     — required-ish, Shopify treats blank as OK
    contact[email]                    — Shopify-validated; error surfaces here
    contact[phone]                    — optional
    contact[Enquiry type]             — select; key appears verbatim in email
    contact[body]                     — textarea

  All §22 styling lives in assets/vf-tokens.css.
{%- endcomment -%}

<section class="vf-contact" data-mode="bone">
  <div class="vf-contact__inner page-width page-width--narrow">

    <header class="vf-contact__header">
      {%- if section.settings.eyebrow != blank -%}
        {%- render 'vf-eyebrow', text: section.settings.eyebrow -%}
      {%- endif -%}
      <h1 class="vf-contact__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="vf-contact__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <hr class="vf-contact__rule" aria-hidden="true">

    {%- form 'contact', id: 'VfContactForm', class: 'vf-contact__form' -%}

      {%- if form.posted_successfully? -%}
        <div class="vf-contact__status vf-contact__status--success" role="status" tabindex="-1" autofocus>
          <p class="vf-contact__status-text">
            {%- if section.settings.success_message != blank -%}
              {{ section.settings.success_message | escape }}
            {%- else -%}
              {{ 'templates.contact.form.post_success' | t }}
            {%- endif -%}
          </p>
        </div>
      {%- elsif form.errors -%}
        <div class="vf-contact__status vf-contact__status--error" role="alert" tabindex="-1" autofocus>
          <p class="vf-contact__status-text">
            {{ 'templates.contact.form.error_heading' | t }}
          </p>
          <ul class="vf-contact__status-list" role="list">
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#VfContactForm-{{ field }}" class="vf-contact__status-link">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="vf-contact__fields">

        <div class="vf-contact__field">
          <label class="vf-contact__label" for="VfContactForm-name">
            {{ 'templates.contact.form.name' | t }}
          </label>
          <input
            class="vf-contact__input"
            type="text"
            id="VfContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            autocomplete="name"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >
        </div>

        <div class="vf-contact__field{% if form.errors contains 'email' %} vf-contact__field--error{% endif %}">
          <label class="vf-contact__label" for="VfContactForm-email">
            {{ 'templates.contact.form.email' | t }}
            <span class="vf-contact__required" aria-hidden="true">*</span>
          </label>
          <input
            class="vf-contact__input"
            type="email"
            id="VfContactForm-email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            aria-required="true"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="VfContactForm-email-error"
            {% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <small class="vf-contact__field-error" id="VfContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>

        <div class="vf-contact__field">
          <label class="vf-contact__label" for="VfContactForm-phone">
            {{ 'templates.contact.form.phone' | t }}
            <span class="vf-contact__optional">(optional)</span>
          </label>
          <input
            class="vf-contact__input"
            type="tel"
            id="VfContactForm-phone"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            autocomplete="tel"
            inputmode="tel"
            pattern="[0-9+\-\s]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
        </div>

        <div class="vf-contact__field">
          <label class="vf-contact__label" for="VfContactForm-enquiry">
            Enquiry type
          </label>
          <div class="vf-contact__select-wrap">
            <select
              class="vf-contact__select"
              id="VfContactForm-enquiry"
              name="contact[Enquiry type]"
            >
              <option value="General">General</option>
              <option value="Atelier brief">Atelier brief</option>
              <option value="Press">Press</option>
            </select>
            <span class="vf-contact__select-arrow" aria-hidden="true">↓</span>
          </div>
        </div>

        <div class="vf-contact__field">
          <label class="vf-contact__label" for="VfContactForm-body">
            {{ 'templates.contact.form.comment' | t }}
          </label>
          <textarea
            class="vf-contact__textarea"
            id="VfContactForm-body"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            rows="8"
          >{{- form.body -}}</textarea>
        </div>

      </div>

      <div class="vf-contact__submit-row">
        <button type="submit" class="vf-contact__submit">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>

    {%- endform -%}

    <hr class="vf-contact__rule vf-contact__rule--identity" aria-hidden="true">

    <section class="vf-contact__identity" aria-labelledby="VfContactIdentityHeading">
      <h2 id="VfContactIdentityHeading" class="vf-contact__identity-heading">Studio of record.</h2>

      <dl class="vf-contact__identity-list">
        {%- if section.settings.legal_name != blank -%}
          <div class="vf-contact__identity-row">
            <dt class="vf-contact__identity-label">Legal name</dt>
            <dd class="vf-contact__identity-value">{{ section.settings.legal_name | escape }}</dd>
          </div>
        {%- endif -%}

        {%- if section.settings.studio_address != blank -%}
          <div class="vf-contact__identity-row">
            <dt class="vf-contact__identity-label">Studio address</dt>
            <dd class="vf-contact__identity-value vf-contact__identity-value--block">
              {{ section.settings.studio_address | newline_to_br }}
            </dd>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_email != blank -%}
          <div class="vf-contact__identity-row">
            <dt class="vf-contact__identity-label">Contact</dt>
            <dd class="vf-contact__identity-value">
              <a class="vf-contact__identity-link" href="mailto:{{ section.settings.contact_email | escape }}">
                {{- section.settings.contact_email | escape -}}
              </a>
            </dd>
          </div>
        {%- endif -%}

        {%- if section.settings.grievance_officer != blank -%}
          <div class="vf-contact__identity-row">
            <dt class="vf-contact__identity-label">Grievance officer</dt>
            <dd class="vf-contact__identity-value vf-contact__identity-value--block">
              {{ section.settings.grievance_officer }}
            </dd>
          </div>
        {%- endif -%}
      </dl>
    </section>

  </div>
</section>

{% schema %}
{
  "name": "VF Contact",
  "class": "vf-contact-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to the studio."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "<p>For enquiries about open editions, Atelier commissions, or press requests. The studio replies within two working days.</p>"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Message received. The studio will reply within two working days."
    },
    {
      "type": "header",
      "content": "Studio identity"
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Registered legal name",
      "default": "[PLACEHOLDER — Registered legal name]"
    },
    {
      "type": "textarea",
      "id": "studio_address",
      "label": "Studio address",
      "default": "[PLACEHOLDER — Studio address]"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "[PLACEHOLDER — contact email]"
    },
    {
      "type": "richtext",
      "id": "grievance_officer",
      "label": "Grievance officer",
      "default": "<p>[PLACEHOLDER — Grievance officer name, role, contact route]</p>"
    }
  ],
  "presets": [
    {
      "name": "VF Contact"
    }
  ]
}
{% endschema %}
