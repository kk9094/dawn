{%- comment -%}
  vf-mono — DM Mono utility text

  Required:
    text     — the text to render

  Optional:
    size     — 'micro' (9px) | 'small' (10px, default) | 'base' (11px) | 'large' (12px) | 'display' (26px)
    color    — 'fg-1' (default) | 'fg-2' | 'fg-3' | 'gold' | 'teal' | 'ember'
    tier     — 'I' | 'II' | 'Atelier' — takes precedence over color if both provided
    as       — HTML element (default 'span')
    class    — extra class names

  Usage:
    {% render 'vf-mono', text: 'FIG. 04 · INTERNAL GEOMETRY · GYROID 40%', size: 'micro' %}
    {% render 'vf-mono', text: '04 / 30', color: 'gold' %}
    {% render 'vf-mono', text: 'Série II', tier: 'II', size: 'base' %}

  Rules:
    - Mono is for metadata, edition marks, technical labels.
      Never for body copy or headlines.
    - tier parameter resolves through --vf-color-tier-* semantic aliases.
{%- endcomment -%}

{%- liquid
  assign tag = as | default: 'span'
  assign size = size | default: 'small'
  assign color = color | default: 'fg-1'
  assign _modifier = color
  if tier
    case tier
      when 'I'
        assign _modifier = 'tier-i'
      when 'II'
        assign _modifier = 'tier-ii'
      when 'Atelier'
        assign _modifier = 'tier-atelier'
    endcase
  endif
-%}

{%- comment -%}
  CSS lives in assets/vf-tokens.css §26 · A (QA #17 relocation, 2026-07-04).
  The snippet emits markup only; do not restore an inline {% style %} block
  here without matching the token file. Snippet-registered styles were
  duplicating on every render (~32 tags/Home).
{%- endcomment -%}
<{{ tag }} class="vf-mono vf-mono--{{ size }} vf-mono--{{ _modifier }} {{ class }}">{{ text | escape }}</{{ tag }}>
